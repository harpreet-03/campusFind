<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="New Post"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:src="@drawable/ic_acc"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSelectImage"
            android:text="Select Photo"
            android:backgroundTint="@color/title"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etTitle"
            android:hint="Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etZone"
            android:hint="Location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etContact"
            android:hint="Contact Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text|phone"/>

        <RadioGroup
            android:id="@+id/rgType"
            android:orientation="horizontal"
            android:checkedButton="@+id/rbLost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:outlineAmbientShadowColor="@color/accent"
            android:outlineSpotShadowColor="@color/accent">
            <RadioButton android:id="@+id/rbLost" android:textColor="@color/primary_dark"  android:text="Lost" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/rbFound" android:text="Found" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        </RadioGroup>

        <EditText
            android:id="@+id/etDesc"
            android:hint="Description..."
            android:lines="3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textMultiLine"/>

        <Button
            android:id="@+id/btnPost"
            android:text="Post to Feed"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>